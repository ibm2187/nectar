[Unit]
Description=Nectar Web Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/nectar
ExecStartPre=/bin/bash /home/ubuntu/nectar/cloud/scripts/boot.sh
ExecStart=/usr/bin/node /home/ubuntu/nectar/src/web-server.js
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/ubuntu/nectar.log
StandardError=append:/home/ubuntu/nectar.log
Environment=NODE_ENV=production
# Web hydrates full state (1000+ releases, 500k+ audit entries) and
# JSON.stringify doubles the heap briefly — 512M OOM'd ~45s after boot.
# 2048 is ~2x observed RSS and fits on an 8GB host beside the sync worker.
Environment=NODE_OPTIONS=--max-old-space-size=2048

TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
