[Unit]
Description=Poll origin/main for Nectar updates every 5 minutes
Requires=nectar-update.service

[Timer]
# Wait 2 minutes after boot before the first run (let nectar settle first)
OnBootSec=2min
# Then run every 5 minutes (measured from the last run's completion)
OnUnitActiveSec=5min
# If the system was off when a run was due, catch up on boot
Persistent=true
Unit=nectar-update.service

[Install]
WantedBy=timers.target
