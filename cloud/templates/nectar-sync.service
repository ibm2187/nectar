[Unit]
Description=Nectar Sync Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/nectar
ExecStartPre=/bin/bash /home/ubuntu/nectar/cloud/scripts/boot.sh
ExecStart=/usr/bin/node /home/ubuntu/nectar/src/sync-worker.js
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/ubuntu/nectar-sync.log
StandardError=append:/home/ubuntu/nectar-sync.log
Environment=NODE_ENV=production
# Sync runs all engines; observed RSS ~625M steady. 2048 is 3x headroom
# and keeps web + sync caps within the 8GB host budget.
Environment=NODE_OPTIONS=--max-old-space-size=2048

TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
