# Server
WEB_PORT=4000
WEB_TOKEN=your-secret-token

# GitHub API
GITHUB_TOKEN=

# JIRA
JIRA_BASE_URL=https://vivtechnologies.atlassian.net
JIRA_EMAIL=
JIRA_TOKEN=

# Jenkins
JENKINS_BASE_URL=https://jenkins.vivtechnologies.com
JENKINS_USER=
JENKINS_TOKEN=

# Slack (for notifications)
SLACK_BOT_TOKEN=
SLACK_RELEASES_CHANNEL=releases
SLACK_DEPLOYS_CHANNEL=deploys

# Google SSO (optional — omit ENABLE_GOOGLE_SSO to disable auth entirely)
# When ENABLE_GOOGLE_SSO is not set, Nectar runs in open-access mode (dev mode).
# ENABLE_GOOGLE_SSO=true
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ALLOWED_DOMAIN=vivtechnologies.com
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# JWT secret — used for SSO session cookies. Generate a random string.
# Required when ENABLE_GOOGLE_SSO=true
JWT_SECRET=change-me

# Access control — comma-separated admin emails (full config access)
# Everyone else with @vivtechnologies.com gets read-only (no config pages)
# If not set, everyone is admin (backward compat)
# NECTAR_ADMINS=admin1@vivtechnologies.com,admin2@vivtechnologies.com

# Hive (optional — for bidirectional integration)
HIVE_URL=http://localhost:3000
HIVE_TOKEN=
