{
  "name": "nectar",
  "version": "0.1.0",
  "description": "Release cycle management for Viv",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:web": "node src/web-server.js",
    "start:sync": "node src/sync-worker.js",
    "dev": "node --watch-path=src src/index.js",
    "dev:web": "node --watch-path=src src/web-server.js",
    "dev:sync": "node --watch-path=src src/sync-worker.js",
    "dev:split": "node --watch-path=src src/web-server.js & node --watch-path=src src/sync-worker.js & wait",
    "dev:client": "cd client && npx vite",
    "build:client": "cd client && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "release-management",
    "jira",
    "github",
    "cherry-pick",
    "deployment"
  ],
  "author": "Nukul Bhasin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mavencare/nectar.git"
  },
  "dependencies": {
    "@aws-sdk/client-codebuild": "^3.967.0",
    "@aws-sdk/client-codedeploy": "^3.967.0",
    "@aws-sdk/client-codepipeline": "^3.967.0",
    "@aws-sdk/client-s3": "^3.967.0",
    "@aws-sdk/client-sts": "^3.967.0",
    "@aws-sdk/s3-request-presigner": "^3.967.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@slack/bolt": "^4.6.0",
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.3.2",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "vitest": "^1.6.1"
  }
}
